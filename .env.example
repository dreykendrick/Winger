# Winger Flutter App Environment Configuration Example
ENVIRONMENT=development|staging|production
APP_NAME=Winger
APP_BUNDLE_ID=co.winger.app

# Supabase Backend V2 Configuration
SUPABASE_URL=https://your-project-ref.supabase.co
SUPABASE_ANON_KEY=your_public_anon_key_here

# API & Gateway Configuration
API_BASE_URL=https://your-project-ref.supabase.co/functions/v1
API_TIMEOUT_SECONDS=15
ENABLE_LOGGING=true
ENABLE_ANALYTICS=false
